# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Entornos virtuales ---
venv/
.venv/
env/
ENV/

# --- Variables de entorno / secretos ---
.env
.env.*
!.env.example

# --- Datos del proyecto (no versionar contenido, solo estructura) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Imágenes generadas / capturas (excepto ejemplos documentados) ---
*.jpg
*.jpeg
*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.png

# --- Checkpoints y pesos de modelos (YOLO26 / PyTorch / ONNX) ---
*.pt
*.onnx
*.pth
*.weights
checkpoints/

# --- Reportes generados (Excel, CSV, PDF) ---
*.xlsx
*.csv
*.pdf
!docs/**/*.pdf

# --- graphify: el grafo se regenera localmente (ver CLAUDE.md) ---
graphify-out/

# --- Claude Code: configuracion personal (la compartida es .claude/settings.json) ---
.claude/settings.local.json
CLAUDE.local.md

# --- Herramientas / IDEs ---
.vscode/
.idea/
*.swp

# --- Pytest / cobertura ---
.pytest_cache/
.coverage
htmlcov/

# --- Sistema operativo ---
.DS_Store
Thumbs.db
